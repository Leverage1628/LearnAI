<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEVERAGE · GTCC OPERATIONS</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --void:     #07090d;
  --s1:       #0d1018;
  --s2:       #121720;
  --s3:       #171e2a;
  --border:   #1e2636;
  --border2:  #252f40;
  --red:      #c41e3a;
  --red-dim:  rgba(196,30,58,0.1);
  --red-line: rgba(196,30,58,0.2);
  --gold:     #c9a84c;
  --gold-dim: rgba(201,168,76,0.08);
  --gold-line:rgba(201,168,76,0.25);
  --cyan:     #0ecfd6;
  --cyan-dim: rgba(14,207,214,0.07);
  --steel:    #3a4a62;
  --text:     #d4dce8;
  --text2:    #7a8fa8;
  --text3:    #3d5070;
  --mono:     'Share Tech Mono', monospace;
  --display:  'Orbitron', sans-serif;
  --body:     'Inter', sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--void);color:var(--text);font-family:var(--body);min-height:100vh;overflow-x:hidden}

/* subtle dot grid */
body::before{
  content:'';position:fixed;inset:0;
  background-image:radial-gradient(rgba(196,30,58,0.06) 1px,transparent 1px);
  background-size:28px 28px;
  pointer-events:none;z-index:0;
}

/* ── HERO ── */
.hero{
  position:relative;z-index:1;
  padding:36px 24px 32px;
  border-bottom:1px solid var(--border);
  overflow:hidden;
}
.hero::after{
  content:'';position:absolute;
  top:-100px;right:-100px;
  width:400px;height:400px;
  background:radial-gradient(circle,rgba(196,30,58,0.06) 0%,transparent 65%);
  pointer-events:none;
}
.hero-top{
  display:flex;align-items:flex-start;
  justify-content:space-between;gap:16px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.hero-left{}
.hero-eyebrow{
  font-family:var(--mono);font-size:9px;
  letter-spacing:0.22em;color:var(--red);
  text-transform:uppercase;margin-bottom:10px;
  opacity:0.8;
}
.hero-name{
  font-family:var(--display);
  font-size:clamp(22px,5vw,34px);
  font-weight:900;color:#fff;
  letter-spacing:0.06em;
  text-transform:uppercase;
  line-height:1.05;margin-bottom:6px;
}
.hero-name span{color:var(--red);}
.hero-subtitle{
  font-family:var(--mono);font-size:10px;
  color:var(--text2);letter-spacing:0.12em;
  text-transform:uppercase;
}

/* status pills */
.hero-status{
  display:flex;flex-direction:column;
  align-items:flex-end;gap:6px;
  flex-shrink:0;
}
.status-pill{
  font-family:var(--mono);font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  padding:5px 12px;border:1px solid;
}
.pill-active{color:var(--gold);border-color:var(--gold-line);background:var(--gold-dim);}
.pill-school{color:var(--cyan);border-color:rgba(14,207,214,0.25);background:var(--cyan-dim);}

/* stat row */
.hero-stats{
  display:flex;gap:0;
  border:1px solid var(--border);
  overflow:hidden;
}
.hstat{
  flex:1;padding:14px 16px;
  border-right:1px solid var(--border);
}
.hstat:last-child{border-right:none;}
.hstat-n{
  font-family:var(--display);font-size:20px;
  font-weight:700;color:var(--gold);
  line-height:1;margin-bottom:4px;
}
.hstat-l{
  font-family:var(--mono);font-size:8px;
  color:var(--text3);letter-spacing:0.12em;
  text-transform:uppercase;
}

/* progress */
.prog-bar{
  position:relative;z-index:1;
  background:var(--s1);
  border-bottom:1px solid var(--border);
  padding:10px 24px;
  display:flex;align-items:center;gap:14px;
}
.prog-lbl{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.14em;text-transform:uppercase;white-space:nowrap;}
.prog-track{flex:1;height:2px;background:var(--border2);position:relative;overflow:hidden;}
.prog-fill{position:absolute;left:0;top:0;bottom:0;width:0%;background:linear-gradient(90deg,var(--red),var(--gold));transition:width .7s ease;}
.prog-num{font-family:var(--mono);font-size:10px;color:var(--gold);white-space:nowrap;}

/* ── NAV ── */
.nav{
  position:sticky;top:0;z-index:20;
  background:rgba(7,9,13,0.96);
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--border);
  display:flex;overflow-x:auto;scrollbar-width:none;
}
.nav::-webkit-scrollbar{display:none}
.nbtn{
  background:none;border:none;
  border-bottom:2px solid transparent;
  color:var(--text3);
  font-family:var(--mono);font-size:9px;
  letter-spacing:0.16em;text-transform:uppercase;
  padding:14px 20px 13px;cursor:pointer;
  white-space:nowrap;transition:all .2s;
}
.nbtn.active{color:var(--red);border-bottom-color:var(--red);}
.nbtn:hover:not(.active){color:var(--text2);}

/* ── PANELS ── */
.panel{display:none;position:relative;z-index:1;padding:32px 22px;max-width:780px;}
.panel.active{display:block;}

/* section header */
.sec{
  display:flex;align-items:center;gap:12px;
  margin-bottom:18px;margin-top:36px;
}
.sec:first-child{margin-top:0;}
.sec-line{flex:1;height:1px;background:var(--border);}
.sec-txt{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.18em;text-transform:uppercase;white-space:nowrap;}
.sec-pip{width:4px;height:4px;background:var(--red);flex-shrink:0;}

/* ── SEMESTER BLOCK ── */
.sem{
  background:var(--s1);border:1px solid var(--border);
  margin-bottom:12px;position:relative;
}
/* corner marks */
.sem::before,.sem::after{
  content:'';position:absolute;
  width:8px;height:8px;border-style:solid;
  border-color:var(--red);opacity:0.35;
}
.sem::before{top:-1px;left:-1px;border-width:1px 0 0 1px;}
.sem::after{bottom:-1px;right:-1px;border-width:0 1px 1px 0;}

.sem-hdr{
  display:flex;align-items:center;gap:12px;
  padding:14px 18px;cursor:pointer;
  user-select:none;transition:background .15s;
}
.sem-hdr:hover{background:rgba(196,30,58,0.03);}
.sem.open .sem-hdr{border-bottom:1px solid var(--border);}

.sem-badge{
  font-family:var(--display);font-size:8px;font-weight:700;
  letter-spacing:0.1em;padding:4px 9px;border:1px solid;
  text-transform:uppercase;flex-shrink:0;
}
.b-red{color:var(--red);border-color:rgba(196,30,58,0.35);background:var(--red-dim);}
.b-gold{color:var(--gold);border-color:var(--gold-line);background:var(--gold-dim);}
.b-cyan{color:var(--cyan);border-color:rgba(14,207,214,0.3);background:var(--cyan-dim);}
.b-now{color:#00d97e;border-color:rgba(0,217,126,0.35);background:rgba(0,217,126,0.08);}

.sem-title{font-size:13px;font-weight:600;color:var(--text);flex:1;letter-spacing:0.01em;}
.sem-cr{font-family:var(--mono);font-size:9px;color:var(--text3);}
.sem-arr{color:var(--steel);font-size:11px;transition:transform .2s;}
.sem.open .sem-arr{transform:rotate(180deg);color:var(--red);}
.sem-body{display:none;}
.sem.open .sem-body{display:block;}

/* ── COURSE ROW ── */
.crow{
  padding:13px 18px;border-bottom:1px solid rgba(30,38,54,0.7);
  position:relative;transition:background .12s;
}
.crow:last-child{border-bottom:none;}
.crow:hover{background:rgba(14,207,214,0.02);}
.crow::before{
  content:'';position:absolute;left:0;top:0;bottom:0;
  width:2px;background:transparent;transition:background .2s;
}
.crow:hover::before{background:var(--cyan);}
.crow.done::before{background:var(--gold);}

.crow-top{display:flex;align-items:flex-start;gap:12px;cursor:pointer;}
.c-chk{
  width:18px;height:18px;border:1px solid var(--steel);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;cursor:pointer;margin-top:2px;
  background:var(--void);transition:all .18s;
}
.crow.done .c-chk{background:var(--gold);border-color:var(--gold);}
.c-chk svg{display:none;}
.crow.done .c-chk svg{display:block;}
.crow.done .c-name{color:var(--text3);text-decoration:line-through;}

.c-info{flex:1;min-width:0;}
.c-code{font-family:var(--mono);font-size:9px;color:var(--red);letter-spacing:0.1em;margin-bottom:3px;}
.c-name{font-size:13px;font-weight:500;color:var(--text);margin-bottom:6px;line-height:1.3;}
.c-tags{display:flex;flex-wrap:wrap;gap:5px;}
.tag{font-family:var(--mono);font-size:9px;padding:2px 7px;border:1px solid;letter-spacing:0.04em;}
.t-r{color:var(--red);border-color:rgba(196,30,58,0.28);background:var(--red-dim);}
.t-g{color:var(--gold);border-color:var(--gold-line);background:var(--gold-dim);}
.t-c{color:var(--cyan);border-color:rgba(14,207,214,0.22);background:var(--cyan-dim);}
.t-s{color:var(--text3);border-color:var(--border);background:transparent;}

.c-xbtn{
  font-family:var(--mono);font-size:9px;letter-spacing:0.1em;
  color:var(--text3);background:none;border:1px solid var(--border);
  padding:3px 9px;cursor:pointer;flex-shrink:0;margin-top:1px;
  transition:all .15s;
}
.c-xbtn:hover{color:var(--cyan);border-color:var(--cyan);}

/* expanded detail */
.c-detail{
  display:none;margin-top:10px;
  padding:11px 14px;
  background:var(--s2);border-left:2px solid var(--cyan);
  font-size:11px;color:var(--text2);line-height:1.7;
}
.crow.xopen .c-detail{display:block;}
.c-detail strong{color:var(--cyan);font-family:var(--mono);font-size:10px;letter-spacing:0.06em;}
.c-detail em{color:var(--gold);font-style:normal;font-weight:600;}

/* notes section */
.c-notes-wrap{margin-top:10px;}
.c-notes-lbl{
  font-family:var(--mono);font-size:9px;color:var(--text3);
  letter-spacing:0.14em;text-transform:uppercase;margin-bottom:5px;
}
.c-notes{
  width:100%;background:var(--void);border:1px solid var(--border);
  color:var(--text);font-family:var(--mono);font-size:11px;
  padding:10px 12px;line-height:1.6;resize:vertical;min-height:64px;
  transition:border-color .2s;outline:none;
}
.c-notes:focus{border-color:var(--red);}
.c-notes-save{
  margin-top:6px;font-family:var(--mono);font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  background:none;border:1px solid var(--border);
  color:var(--text3);padding:5px 12px;cursor:pointer;
  transition:all .15s;
}
.c-notes-save:hover{color:var(--gold);border-color:var(--gold-line);}
.c-notes-saved{color:var(--gold);font-family:var(--mono);font-size:9px;margin-left:8px;opacity:0;transition:opacity .3s;}
.c-notes-saved.show{opacity:1;}

/* ── CERT CARDS ── */
.cert-grid{display:flex;flex-direction:column;gap:10px;}
.cert-card{
  background:var(--s1);border:1px solid var(--border);
  padding:16px 18px;position:relative;
  display:flex;align-items:flex-start;gap:16px;
}
.cert-card::before{
  content:'';position:absolute;
  left:0;top:0;bottom:0;width:2px;
}
.cc-red::before{background:var(--red);}
.cc-gold::before{background:var(--gold);}
.cc-cyan::before{background:var(--cyan);}

.cert-num{
  font-family:var(--display);font-size:22px;font-weight:900;
  color:var(--border2);flex-shrink:0;line-height:1;
  min-width:28px;text-align:right;
  transition:color .2s;
}
.cert-card.cc-done .cert-num{color:var(--gold);}

.cert-body{flex:1;min-width:0;}
.cert-eyebrow{
  font-family:var(--mono);font-size:9px;
  letter-spacing:0.16em;text-transform:uppercase;
  margin-bottom:5px;
}
.cc-red .cert-eyebrow{color:var(--red);}
.cc-gold .cert-eyebrow{color:var(--gold);}
.cc-cyan .cert-eyebrow{color:var(--cyan);}

.cert-title{
  font-family:var(--display);font-size:11px;font-weight:700;
  color:#fff;letter-spacing:0.04em;text-transform:uppercase;
  margin-bottom:6px;
}
.cert-desc{font-size:11px;color:var(--text2);line-height:1.6;margin-bottom:10px;}
.cert-tags{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px;}

/* cert progress bar */
.cert-prog-wrap{margin-top:2px;}
.cert-prog-lbl{
  display:flex;justify-content:space-between;
  font-family:var(--mono);font-size:9px;color:var(--text3);
  margin-bottom:5px;
}
.cert-prog-track{height:2px;background:var(--border2);}
.cert-prog-fill{height:100%;background:linear-gradient(90deg,var(--red),var(--gold));transition:width .5s;}

/* cert notes */
.cert-notes-wrap{margin-top:10px;border-top:1px solid var(--border);padding-top:10px;}

/* cert check */
.cert-chk-row{display:flex;align-items:center;gap:10px;margin-top:10px;}
.cert-chk{
  width:16px;height:16px;border:1px solid var(--steel);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;flex-shrink:0;background:var(--void);transition:all .18s;
}
.cert-card.cc-done .cert-chk{background:var(--gold);border-color:var(--gold);}
.cert-chk svg{display:none;}
.cert-card.cc-done .cert-chk svg{display:block;}
.cert-chk-lbl{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:0.1em;cursor:pointer;}

/* ── GITHUB SECTION ── */
.gh-header{
  background:var(--s1);border:1px solid var(--border);
  padding:18px 20px;margin-bottom:12px;
  display:flex;align-items:center;gap:14px;
}
.gh-icon{color:var(--text2);flex-shrink:0;}
.gh-info{flex:1;}
.gh-title{font-family:var(--display);font-size:11px;font-weight:700;color:#fff;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:4px;}
.gh-url{font-family:var(--mono);font-size:10px;color:var(--cyan);}
.gh-url a{color:inherit;text-decoration:none;}
.gh-url a:hover{text-decoration:underline;}
.gh-status{font-family:var(--mono);font-size:9px;color:var(--gold);padding:4px 10px;border:1px solid var(--gold-line);background:var(--gold-dim);}

.gh-card{
  background:var(--s1);border:1px solid var(--border);
  padding:16px 18px;margin-bottom:10px;position:relative;
}
.gh-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--red);}
.gh-card-title{font-family:var(--mono);font-size:10px;color:var(--red);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:6px;}
.gh-card-body{font-size:11px;color:var(--text2);line-height:1.65;margin-bottom:10px;}
.gh-card-code{
  background:var(--void);border:1px solid var(--border);
  padding:10px 14px;font-family:var(--mono);font-size:10px;
  color:var(--cyan);line-height:1.8;overflow-x:auto;
  margin-bottom:4px;
}
.gh-card-code .cm{color:var(--text3);}
.gh-card-code .ck{color:var(--red);}
.gh-card-code .cv{color:var(--gold);}

/* commit log input */
.commit-input{
  width:100%;background:var(--void);border:1px solid var(--border);
  color:var(--text);font-family:var(--mono);font-size:11px;
  padding:9px 12px;outline:none;transition:border-color .2s;
}
.commit-input:focus{border-color:var(--red);}
.commit-btn{
  margin-top:6px;font-family:var(--mono);font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  background:var(--red-dim);border:1px solid rgba(196,30,58,0.35);
  color:var(--red);padding:6px 14px;cursor:pointer;
  transition:all .15s;
}
.commit-btn:hover{background:rgba(196,30,58,0.18);}

.commit-log{margin-top:10px;}
.commit-entry{
  display:flex;align-items:baseline;gap:10px;
  padding:7px 0;border-bottom:1px solid var(--border);
  font-family:var(--mono);font-size:10px;
}
.commit-entry:last-child{border-bottom:none;}
.commit-hash{color:var(--cyan);flex-shrink:0;}
.commit-msg{color:var(--text2);flex:1;}
.commit-date{color:var(--text3);flex-shrink:0;font-size:9px;}

/* ── SALARY ROWS ── */
.sal-row{
  background:var(--s1);border:1px solid var(--border);
  padding:15px 18px;margin-bottom:9px;
  display:flex;align-items:center;gap:14px;
  position:relative;
}
.sal-row::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--border);}
.sal-row.s1::before{background:var(--steel);}
.sal-row.s2::before{background:rgba(201,168,76,.4);}
.sal-row.s3::before{background:rgba(201,168,76,.65);}
.sal-row.s4::before{background:var(--red);}
.sal-row.s5::before{background:var(--gold);}
.sal-row.s6::before{background:var(--cyan);}
.sal-left{flex:1;min-width:0;}
.sal-stage{font-family:var(--mono);font-size:9px;color:var(--text3);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;}
.sal-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:3px;}
.sal-certs{font-family:var(--mono);font-size:9px;color:var(--text3);}
.sal-bar-wrap{height:2px;background:var(--border2);margin-top:9px;}
.sal-bar{height:100%;background:linear-gradient(90deg,var(--red),var(--gold));}
.sal-amt{font-family:var(--display);font-size:14px;font-weight:700;color:var(--gold);white-space:nowrap;flex-shrink:0;}

/* note box */
.note{
  background:var(--s2);border:1px solid var(--border);
  border-left:2px solid var(--red);
  padding:14px 16px;font-size:11px;
  color:var(--text2);line-height:1.65;
  margin-top:14px;position:relative;
}
.note::before{
  content:'NOTE';position:absolute;
  top:-7px;left:14px;background:var(--void);
  padding:0 6px;font-family:var(--mono);
  font-size:8px;letter-spacing:0.2em;color:var(--red);
}
.note strong{color:var(--gold);}

/* ── EDU STEPS ── */
.edu-wrap{padding-left:22px;position:relative;}
.edu-wrap::before{
  content:'';position:absolute;left:8px;top:8px;bottom:8px;width:1px;
  background:repeating-linear-gradient(180deg,var(--red) 0,var(--red) 5px,transparent 5px,transparent 10px);
}
.edu-step{position:relative;margin-bottom:5px;}
.edu-node{
  position:absolute;left:-19px;top:15px;
  width:16px;height:16px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:7px;font-weight:700;
  border:1px solid;background:var(--void);z-index:1;
}
.n-red{color:var(--red);border-color:var(--red);}
.n-gold{color:var(--gold);border-color:var(--gold);}
.n-cyan{color:var(--cyan);border-color:var(--cyan);}
.edu-card{
  background:var(--s1);border:1px solid var(--border);
  padding:14px 16px;margin-bottom:16px;
}
.edu-stage{font-family:var(--mono);font-size:9px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:4px;}
.edu-stage.r{color:var(--red);}
.edu-stage.g{color:var(--gold);}
.edu-stage.c{color:var(--cyan);}
.edu-title{font-family:var(--display);font-size:11px;font-weight:700;color:#fff;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:6px;}
.edu-body{font-size:11px;color:var(--text2);line-height:1.65;margin-bottom:7px;}
.edu-schools{font-family:var(--mono);font-size:9px;color:var(--text3);}

</style>
</head>
<body>

<!-- HERO -->
<div class="hero">
  <div class="hero-top">
    <div class="hero-left">
      <div class="hero-eyebrow">STUDENT ID: 1859163 · GTCC · FALL 2026</div>
      <div class="hero-name">LEVERAGE<span>·</span></div>
      <div class="hero-subtitle">Electrical Systems Technology · Diploma → AAS → B.S. → M.S.</div>
    </div>
    <div class="hero-status">
      <div class="status-pill pill-now" style="color:#00d97e;border-color:rgba(0,217,126,0.3);background:rgba(0,217,126,0.07);">● ENROLLED · ACTIVE</div>
      <div class="status-pill pill-school">GTCC · GREENSBORO NC</div>
      <div class="status-pill pill-active">AID: $3,848 · BALANCE: $0</div>
    </div>
  </div>
