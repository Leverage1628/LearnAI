<script>
// NAV
function show(id){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nbtn').forEach(b=>b.classList.remove('active'));
  document.getElementById('panel-'+id).classList.add('active');
  event.target.classList.add('active');
}

// SEMESTER TOGGLE
function togSem(hdr){ hdr.closest('.sem').classList.toggle('open'); }

// COURSE EXPAND
function togExpand(id){
  document.getElementById(id).classList.toggle('xopen');
}

// MARK DONE
function markDone(e,id){
  e.stopPropagation();
  document.getElementById(id).classList.toggle('done');
  updateProgress();
}

// PROGRESS
function updateProgress(){
  const all=document.querySelectorAll('.crow').length;
  const done=document.querySelectorAll('.crow.done').length;
  const pct=all>0?(done/all*100):0;
  document.getElementById('pFill').style.width=pct+'%';
  document.getElementById('pCount').textContent=done+' / '+all;
}
updateProgress();

// NOTES SAVE
function saveNote(id,val,btn){
  try{ localStorage.setItem('note_'+id,val); }catch(e){}
  if(btn){
    const s=document.getElementById('ns-'+id);
    if(s){s.classList.add('show');setTimeout(()=>s.classList.remove('show'),2000);}
  }
}

// Load saved notes
window.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.crow').forEach(row=>{
    const id=row.id;
    try{
      const v=localStorage.getItem('note_'+id);
      if(v){ const ta=row.querySelector('.c-notes'); if(ta) ta.value=v; }
      if(localStorage.getItem('done_'+id)) row.classList.add('done');
    }catch(e){}
  });
  updateProgress();
});

// CERT DONE
function togCertDone(id){
  const card=document.getElementById(id);
  card.classList.toggle('cc-done');
}

// CERT PROGRESS
function updateCertProg(id,val){
  document.getElementById(id+'-bar').style.width=val+'%';
  document.getElementById(id+'-pct').textContent=val+'%';
}
function updateCertProgAbs(id,val,max){
  const pct=(val/max*100);
  document.getElementById(id+'-bar').style.width=pct+'%';
  document.getElementById(id+'-pct').textContent=val+' / '+max;
}

// COMMIT LOG
function addCommit(){
  const input=document.getElementById('commitInput');
  const msg=input.value.trim();
  if(!msg) return;
  const log=document.getElementById('commitLog');
  const hash=Math.random().toString(16).substr(2,6);
  const now=new Date();
  const dateStr=now.toLocaleDateString('en-US',{month:'short',year:'numeric'});
  const entry=document.createElement('div');
  entry.className='commit-entry';
  entry.innerHTML=`<span class="commit-hash">${hash}</span><span class="commit-msg">${msg}</span><span class="commit-date">${dateStr}</span>`;
  log.insertBefore(entry,log.firstChild);
  input.value='';
  try{
    const logs=JSON.parse(localStorage.getItem('commitLog')||'[]');
    logs.unshift({hash,msg,date:dateStr});
    localStorage.setItem('commitLog',JSON.stringify(logs.slice(0,50)));
  }catch(e){}
}

// Load saved commits
try{
  const logs=JSON.parse(localStorage.getItem('commitLog')||'[]');
  const log=document.getElementById('commitLog');
  logs.forEach(l=>{
    const entry=document.createElement('div');
    entry.className='commit-entry';
    entry.innerHTML=`<span class="commit-hash">${l.hash}</span><span class="commit-msg">${l.msg}</span><span class="commit-date">${l.date}</span>`;
    log.appendChild(entry);
  });
}catch(e){}
</script>
